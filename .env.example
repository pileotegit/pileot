# Supabase Edge Function Secrets (supabase secrets set ...). Nie committen.
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase in Edge Functions automatisch bereit.

# Statische Seiten (Ordner web/), z. B. auf link.pileot.de
CLICK_PAGE_URL=https://link.pileot.de/r/
UNSUB_PAGE_URL=https://link.pileot.de/abmelden/
ALLOWED_ORIGINS=https://link.pileot.de

# Optional, Standard: ${SUPABASE_URL}/functions/v1
# FUNCTIONS_BASE_URL=https://ayostbgfagrncgfmgyms.supabase.co/functions/v1

# Resend: API-Key mit "Sending access", nur für die Domain mail.pileot.de
RESEND_API_KEY=re_xxx
# Resend Webhook Signing Secret (beginnt mit whsec_)
RESEND_WEBHOOK_SECRET=whsec_xxx

# Gemeinsames Secret zwischen n8n (Credential "PILEOT Review Worker") und rv-jobs.
# Mindestens 32 Zeichen, z. B.: openssl rand -hex 32
WORKER_SECRET=

# Betriebswarnungen
OPS_ALERT_EMAIL=hello@pileot.de
OPS_SENDER="PILEOT System" <system@mail.pileot.de>

# Google Business Profile API (erst nach Freigabe durch Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
